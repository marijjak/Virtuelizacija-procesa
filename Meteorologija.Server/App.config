<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<add key="storagePath" value="C:\Meteorologija\Data"/>
		<add key="T_threshold" value="5"/>
		<add key="RH_threshold" value="10"/>
		<add key="DEW_threshold" value="5"/>
	</appSettings>
	<system.serviceModel>
		<bindings>
			<netTcpBinding>
				<binding name="weatherBinding"
						 maxReceivedMessageSize="10485760"
						 receiveTimeout="00:10:00"
						 sendTimeout="00:10:00">
				</binding>
			</netTcpBinding>
		</bindings>
		<services>
			<service name="Meteorologija.Server.WeatherService">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:8090"/>
					</baseAddresses>
				</host>
				<endpoint
				  address="WeatherService"
				  binding="netTcpBinding"
				  bindingConfiguration="weatherBinding"
				  contract="Meteorologija.Common.IWeatherService"/>
			</service>
		</services>
	</system.serviceModel>
</configuration>